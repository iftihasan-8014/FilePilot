<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Color Palette ═══════════════════════════════════════ -->
    <Color x:Key="AppBackgroundColor">#1A1A2E</Color>
    <Color x:Key="AppSurfaceColor">#16213E</Color>
    <Color x:Key="AppSurfaceVariantColor">#1F2B47</Color>
    <Color x:Key="AppPrimaryColor">#7C4DFF</Color>
    <Color x:Key="AppSecondaryColor">#64FFDA</Color>
    <Color x:Key="AppOnSurfaceColor">#E0E0E0</Color>
    <Color x:Key="AppOnSurfaceVariantColor">#9E9E9E</Color>
    <Color x:Key="AppErrorColor">#FF5252</Color>
    <Color x:Key="AppSuccessColor">#69F0AE</Color>
    <Color x:Key="AppWarningColor">#FF9800</Color>
    <Color x:Key="AppInfoColor">#448AFF</Color>

    <!-- ═══ Brushes ═════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppBackgroundBrush"       Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush"          Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceVariantBrush"   Color="{StaticResource AppSurfaceVariantColor}" />
    <SolidColorBrush x:Key="AppPrimaryBrush"          Color="{StaticResource AppPrimaryColor}" />
    <SolidColorBrush x:Key="AppSecondaryBrush"        Color="{StaticResource AppSecondaryColor}" />
    <SolidColorBrush x:Key="AppOnSurfaceBrush"        Color="{StaticResource AppOnSurfaceColor}" />
    <SolidColorBrush x:Key="AppOnSurfaceVariantBrush" Color="{StaticResource AppOnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="AppErrorBrush"            Color="{StaticResource AppErrorColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush"          Color="{StaticResource AppSuccessColor}" />

    <!-- Primary gradient for branding and cards -->
    <LinearGradientBrush x:Key="AppPrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C4DFF" Offset="0" />
        <GradientStop Color="#651FFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppSecondaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#64FFDA" Offset="0" />
        <GradientStop Color="#1DE9B6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppWarningGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9800" Offset="0" />
        <GradientStop Color="#F57C00" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppErrorGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5252" Offset="0" />
        <GradientStop Color="#D32F2F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppSuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#69F0AE" Offset="0" />
        <GradientStop Color="#00C853" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppInfoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#448AFF" Offset="0" />
        <GradientStop Color="#2962FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Sidebar background gradient -->
    <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F1527" Offset="0" />
        <GradientStop Color="#16213E" Offset="0.5" />
        <GradientStop Color="#0F1527" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══ Typography ══════════════════════════════════════════ -->
    <Style x:Key="BrandingText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceBrush}" />
    </Style>

    <Style x:Key="BrandingAccentText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AppPrimaryBrush}" />
    </Style>

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Inter" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceBrush}" />
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceVariantBrush}" />
        <Setter Property="Margin" Value="20,20,0,8" />
        <!-- Letter spacing achieved via font choice; WPF TextBlock lacks CharacterSpacing -->
    </Style>

    <Style x:Key="StatValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="StatLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="#B0B0B0" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="StatTrendText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#A0A0A0" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style x:Key="StatusBarText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceVariantBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ Card Styles ═════════════════════════════════════════ -->
    <Style x:Key="DashboardCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Animations ══════════════════════════════════════════ -->
    <Storyboard x:Key="FadeInStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="SlideInFromRight">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="30" To="0" Duration="0:0:0.35">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.3" />
    </Storyboard>

</ResourceDictionary>
