<Window x:Class="FilePilot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:FilePilot.Converters"
        xmlns:vm="clr-namespace:FilePilot.ViewModels"
        xmlns:views="clr-namespace:FilePilot.Views"
        mc:Ignorable="d"
        Title="FilePilot — Advanced File Organizer"
        Width="1400" Height="860"
        MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:StringToUpperConverter x:Key="StringToUpper" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CategorizerViewModel}">
            <views:CategorizerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DuplicateFinderViewModel}">
            <views:DuplicateFinderView />
        </DataTemplate>

        <!-- Sidebar nav item style -->
        <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                Margin="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{StaticResource AppSurfaceVariantBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#7C4DFF" Opacity="0.18" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══ Outer Layout with Global Margin Inset ═══════════════════ -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Row 0: Body (Sidebar + Content) -->
            <RowDefinition Height="Auto" /> <!-- Row 1: Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ROW 0: MAIN BODY (Sidebar + Content)                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />  <!-- Sidebar -->
                <ColumnDefinition Width="*" />    <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- ─── SIDEBAR CARD ─────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,12,0">
                <DockPanel>

                    <!-- App Branding Header at top of sidebar -->
                    <Border DockPanel.Dock="Top"
                            Padding="18,16"
                            BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="RocketLaunch"
                                                      Width="24" Height="24"
                                                      Foreground="{StaticResource AppPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0" />
                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI, Inter, Roboto">
                                <Run Text="File"
                                     Foreground="{StaticResource AppOnSurfaceBrush}"
                                     FontSize="17" FontWeight="Bold" />
                                <Run Text="Pilot"
                                     Foreground="{StaticResource AppPrimaryBrush}"
                                     FontSize="17" FontWeight="Bold" />
                            </TextBlock>
                            <Border CornerRadius="4"
                                    Background="{StaticResource AppPrimaryBrush}"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="PRO"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Settings button at bottom -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="12,10"
                            BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                            BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                Padding="10,0"
                                Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                Command="{Binding OpenSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog"
                                                          Width="20" Height="20"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />
                                <TextBlock Text="Settings"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Sidebar Navigation Menu -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8">

                            <!-- ── Overview Section ── -->
                            <TextBlock Text="OVERVIEW"
                                       Style="{StaticResource SectionHeaderText}" />
                            <ListBox ItemsSource="{Binding NavigationItems}"
                                     SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource NavListBoxItem}"
                                     SelectionMode="Single"
                                     x:Name="NavigationListBox">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nav Icon -->
                                            <materialDesign:PackIcon Grid.Column="0"
                                                                      Kind="{Binding Icon}"
                                                                      Width="20" Height="20"
                                                                      VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource AppOnSurfaceVariantBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource AppPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>

                                            <!-- Nav Label -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource AppOnSurfaceVariantBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource AppOnSurfaceBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Badge -->
                                            <Border Grid.Column="2"
                                                    Visibility="{Binding Badge, Converter={StaticResource StringToVis}}"
                                                    CornerRadius="8"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#7C4DFF" Opacity="0.2" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Badge}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                                <!-- Group by Category -->
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, Converter={StaticResource StringToUpper}}"
                                                           Style="{StaticResource SectionHeaderText}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ─── MAIN CONTENT AREA CARD ───────────────────── -->
            <Border Grid.Column="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Content Header -->
                        <RowDefinition Height="*" />    <!-- Content Body -->
                    </Grid.RowDefinitions>

                    <!-- Content Header -->
                    <Border Grid.Row="0"
                            Padding="28,14,28,14"
                            Background="Transparent"
                            BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <!-- Page Title -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left">
                                <materialDesign:PackIcon Kind="{Binding CurrentPageIcon}"
                                                          Width="24" Height="24"
                                                          Foreground="{StaticResource AppPrimaryBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0" />
                                <TextBlock Text="{Binding CurrentPageTitle}"
                                           Style="{StaticResource PageTitleText}" />
                            </StackPanel>

                            <!-- Search Box -->
                            <Border DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource AppBackgroundBrush}"
                                    CornerRadius="10"
                                    BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                    BorderThickness="1"
                                    Padding="4,0"
                                    Width="300">
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="Magnify"
                                                              Width="20" Height="20"
                                                              Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                              VerticalAlignment="Center"
                                                              DockPanel.Dock="Left"
                                                              Margin="8,0,4,0" />
                                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Search files, rules, actions..."
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                             materialDesign:HintAssist.HintOpacity="0.5"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource AppOnSurfaceBrush}"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             Padding="4,8" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Content Body — switches based on selected page -->
                    <ContentControl Grid.Row="1"
                                    x:Name="ContentArea" 
                                    Content="{Binding CurrentViewModel}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ROW 1: BOTTOM STATUS BAR                               -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                CornerRadius="10"
                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                BorderThickness="1"
                Margin="0,10,0,0"
                Padding="16,8"
                MinHeight="40">
            <DockPanel>

                <!-- Left: Monitoring Toggle -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AppSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoringActive}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource AppOnSurfaceVariantBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource StatusBarText}"
                               Margin="0,0,8,0">
                        <TextBlock.Text>
                            <Binding Path="IsMonitoringActive"
                                     StringFormat="{}Monitoring: {0}">
                                <Binding.Converter>
                                    <converters:BooleanToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ToggleButton IsChecked="{Binding IsMonitoringActive}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"
                                  Height="20" />
                </StackPanel>

                <!-- Right: Status Counters -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileMultiple"
                                              Width="14" Height="14"
                                              Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0" />
                    <TextBlock Text="{Binding TotalFilesTracked, StringFormat=N0}"
                               Style="{StaticResource StatusBarText}"
                               Margin="0,0,4,0" />
                    <TextBlock Text="files tracked"
                               Style="{StaticResource StatusBarText}"
                               Margin="0,0,20,0" />

                    <materialDesign:PackIcon Kind="ProgressClock"
                                              Width="14" Height="14"
                                              Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0" />
                    <TextBlock Text="{Binding BackgroundTasks}"
                               Style="{StaticResource StatusBarText}"
                               Margin="0,0,4,0" />
                    <TextBlock Text="background tasks"
                               Style="{StaticResource StatusBarText}"
                               Margin="0,0,20,0" />

                    <materialDesign:PackIcon Kind="ClockOutline"
                                              Width="14" Height="14"
                                              Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0" />
                    <TextBlock Text="Last scan: "
                               Style="{StaticResource StatusBarText}" />
                    <TextBlock Text="{Binding LastScanTime}"
                               Style="{StaticResource StatusBarText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
