<UserControl x:Class="FilePilot.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Decorative circle background -->
            <Border Width="120" Height="120"
                    CornerRadius="60"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,28">
                <Border.Background>
                    <SolidColorBrush Color="#7C4DFF" Opacity="0.08" />
                </Border.Background>
                <Border Width="80" Height="80"
                        CornerRadius="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="#7C4DFF" Opacity="0.12" />
                    </Border.Background>
                    <materialDesign:PackIcon Kind="{Binding PageIcon}"
                                             Width="36" Height="36"
                                             Foreground="{StaticResource AppPrimaryBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>
            </Border>

            <!-- Feature name -->
            <TextBlock Text="{Binding PageTitle}"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource AppOnSurfaceBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <!-- Coming Soon label -->
            <Border Background="{StaticResource AppSurfaceVariantBrush}"
                    CornerRadius="12"
                    Padding="16,6"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <TextBlock FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource AppSecondaryBrush}">
                    <Run Text="⚡" /> <Run Text="Coming Soon" />
                </TextBlock>
            </Border>

            <TextBlock Text="This feature is being built. The backend logic will be wired up in the next phase."
                       FontSize="13"
                       Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="360"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
