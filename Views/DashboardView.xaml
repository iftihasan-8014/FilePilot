<UserControl x:Class="FilePilot.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="32,8,32,32">

            <!-- ═══ Welcome Header ════════════════════════════════ -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Welcome back"
                           FontSize="14"
                           Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                           Margin="0,0,0,4" />
                <TextBlock FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource AppOnSurfaceBrush}">
                    <Run Text="Your files are " /><Run Text="organized" Foreground="{StaticResource AppSecondaryBrush}" /><Run Text="." />
                </TextBlock>
                <TextBlock Text="Here's a quick overview of your workspace activity."
                           FontSize="13"
                           Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- ═══ Statistics Cards ══════════════════════════════ -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,28">

                <!-- Card 1: Files Organized -->
                <Border CornerRadius="16" Padding="24" Margin="0,0,12,0"
                        Background="{StaticResource AppPrimaryGradient}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"
                                          Color="#7C4DFF" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <materialDesign:PackIcon Grid.Row="0" Kind="FolderMultiple"
                                                  Width="28" Height="28"
                                                  Foreground="White" Opacity="0.8"
                                                  Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="{Binding FilesOrganized, StringFormat=N0}"
                                   Style="{StaticResource StatValueText}" />
                        <TextBlock Grid.Row="2" Text="Files Organized"
                                   Style="{StaticResource StatLabelText}"
                                   Foreground="White" Opacity="0.8"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Text="{Binding FilesOrganizedTrend}"
                                   Style="{StaticResource StatTrendText}"
                                   Foreground="White" Opacity="0.6"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <!-- Card 2: Duplicates Found -->
                <Border CornerRadius="16" Padding="24" Margin="6,0,6,0"
                        Background="{StaticResource AppWarningGradient}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"
                                          Color="#FF9800" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <materialDesign:PackIcon Grid.Row="0" Kind="ContentDuplicate"
                                                  Width="28" Height="28"
                                                  Foreground="White" Opacity="0.8"
                                                  Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="{Binding DuplicatesFound}"
                                   Style="{StaticResource StatValueText}" />
                        <TextBlock Grid.Row="2" Text="Duplicates Found"
                                   Style="{StaticResource StatLabelText}"
                                   Foreground="White" Opacity="0.8"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Text="{Binding DuplicatesTrend}"
                                   Style="{StaticResource StatTrendText}"
                                   Foreground="White" Opacity="0.6"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <!-- Card 3: Storage Saved -->
                <Border CornerRadius="16" Padding="24" Margin="6,0,6,0"
                        Background="{StaticResource AppSecondaryGradient}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"
                                          Color="#64FFDA" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <materialDesign:PackIcon Grid.Row="0" Kind="HarddiskRemove"
                                                  Width="28" Height="28"
                                                  Foreground="#1A1A2E" Opacity="0.8"
                                                  Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="{Binding StorageSaved}"
                                   Style="{StaticResource StatValueText}"
                                   Foreground="#1A1A2E" />
                        <TextBlock Grid.Row="2" Text="Storage Saved"
                                   Style="{StaticResource StatLabelText}"
                                   Foreground="#1A1A2E" Opacity="0.7"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Text="{Binding StorageSavedTrend}"
                                   Style="{StaticResource StatTrendText}"
                                   Foreground="#1A1A2E" Opacity="0.6"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <!-- Card 4: Active Rules -->
                <Border CornerRadius="16" Padding="24" Margin="12,0,0,0"
                        Background="{StaticResource AppInfoGradient}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"
                                          Color="#448AFF" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <materialDesign:PackIcon Grid.Row="0" Kind="RulerSquareCompass"
                                                  Width="28" Height="28"
                                                  Foreground="White" Opacity="0.8"
                                                  Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="{Binding ActiveRules}"
                                   Style="{StaticResource StatValueText}" />
                        <TextBlock Grid.Row="2" Text="Active Rules"
                                   Style="{StaticResource StatLabelText}"
                                   Foreground="White" Opacity="0.8"
                                   Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Text="{Binding ActiveRulesTrend}"
                                   Style="{StaticResource StatTrendText}"
                                   Foreground="White" Opacity="0.6"
                                   Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ═══ Quick Actions + Recent Activity ═══════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- Recent Activity -->
                <Border Grid.Column="0"
                        Style="{StaticResource DashboardCard}"
                        Margin="0,0,16,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="Recent Activity"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppOnSurfaceBrush}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="Clear All"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                    FontSize="11"
                                    Command="{Binding ClearActivityCommand}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,4"
                                            CornerRadius="10"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource AppSurfaceVariantBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0"
                                                    Width="36" Height="36"
                                                    CornerRadius="10"
                                                    VerticalAlignment="Center">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding AccentColor}"
                                                                     Opacity="0.15" />
                                                </Border.Background>
                                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                         Width="18" Height="18"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Foreground>
                                                        <SolidColorBrush Color="{Binding AccentColor}" />
                                                    </materialDesign:PackIcon.Foreground>
                                                </materialDesign:PackIcon>
                                            </Border>

                                            <!-- Description -->
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource AppOnSurfaceBrush}" />
                                                <TextBlock Text="{Binding Source}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Time -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeAgo}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Quick Actions Panel -->
                <Border Grid.Column="1"
                        Style="{StaticResource DashboardCard}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppOnSurfaceBrush}"
                                   Margin="0,0,0,16" />

                        <!-- Quick Action Buttons -->
                        <Button Margin="0,0,0,8"
                                Height="44"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                Foreground="{StaticResource AppOnSurfaceBrush}"
                                Command="{Binding ScanFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderSearch" Width="20" Height="20"
                                                          Foreground="{StaticResource AppPrimaryBrush}"
                                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Scan Folder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,0,8"
                                Height="44"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                Foreground="{StaticResource AppOnSurfaceBrush}"
                                Command="{Binding FindDuplicatesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentDuplicate" Width="20" Height="20"
                                                          Foreground="#FF9800"
                                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Find Duplicates" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,0,8"
                                Height="44"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                Foreground="{StaticResource AppOnSurfaceBrush}"
                                Command="{Binding BatchRenameCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RenameBox" Width="20" Height="20"
                                                          Foreground="{StaticResource AppSecondaryBrush}"
                                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Batch Rename" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,0,8"
                                Height="44"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                Foreground="{StaticResource AppOnSurfaceBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileChart" Width="20" Height="20"
                                                          Foreground="#FF5252"
                                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Large File Finder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,0,8"
                                Height="44"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                Foreground="{StaticResource AppOnSurfaceBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RulerSquareCompass" Width="20" Height="20"
                                                          Foreground="#448AFF"
                                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Create New Rule" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Height="44"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                Foreground="{StaticResource AppOnSurfaceBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextRecognition" Width="20" Height="20"
                                                          Foreground="#CE93D8"
                                                          Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="OCR Scan Images" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Storage Overview -->
                        <Separator Margin="0,20,0,16" Background="{StaticResource AppSurfaceVariantBrush}" />
                        <TextBlock Text="MONITORED FOLDERS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                   Margin="0,0,0,12" />

                        <StackPanel Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="C:\Users\Downloads"
                                           FontSize="12"
                                           Foreground="{StaticResource AppOnSurfaceBrush}" />
                                <TextBlock Text="Active"
                                           FontSize="11"
                                           Foreground="{StaticResource AppSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar Value="72" Height="4"
                                         Foreground="{StaticResource AppPrimaryBrush}"
                                         Background="{StaticResource AppSurfaceVariantBrush}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="D:\Documents"
                                           FontSize="12"
                                           Foreground="{StaticResource AppOnSurfaceBrush}" />
                                <TextBlock Text="Active"
                                           FontSize="11"
                                           Foreground="{StaticResource AppSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar Value="45" Height="4"
                                         Foreground="{StaticResource AppSecondaryBrush}"
                                         Background="{StaticResource AppSurfaceVariantBrush}" />
                        </StackPanel>

                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="E:\Projects"
                                           FontSize="12"
                                           Foreground="{StaticResource AppOnSurfaceBrush}" />
                                <TextBlock Text="Paused"
                                           FontSize="11"
                                           Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <ProgressBar Value="28" Height="4"
                                         Foreground="#FF9800"
                                         Background="{StaticResource AppSurfaceVariantBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
