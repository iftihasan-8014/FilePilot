<UserControl x:Class="FilePilot.Views.CategorizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FilePilot.Converters">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <StackPanel Margin="32,8,32,32">

                <!-- ═══ Header ═══════════════════════════════════════ -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="File Categorizer"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource AppOnSurfaceBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Automatically sort files into category folders based on extension rules."
                               FontSize="13"
                               Foreground="{StaticResource AppOnSurfaceVariantBrush}" />
                </StackPanel>

                <!-- ═══ Folder Selection Card ════════════════════════ -->
                <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Folder Path Display -->
                        <Border Grid.Column="0"
                                Background="{StaticResource AppBackgroundBrush}"
                                CornerRadius="10"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                BorderThickness="1"
                                Padding="14,10"
                                Margin="0,0,12,0">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="FolderSearch"
                                                         Width="20" Height="20"
                                                         Foreground="{StaticResource AppPrimaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceBrush}" />
                                            <Setter Property="Text" Value="{Binding SelectedFolderPath}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFolderPath}" Value="">
                                                    <Setter Property="Text" Value="No folder selected..." />
                                                    <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceVariantBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Browse Button -->
                        <Button Grid.Column="1"
                                Content="Browse"
                                Margin="0,0,8,0"
                                Height="40" MinWidth="100"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppPrimaryBrush}"
                                Foreground="{StaticResource AppPrimaryBrush}"
                                Command="{Binding BrowseFolderCommand}" />

                        <!-- Organize / Cancel Button -->
                        <Button Grid.Column="2"
                                Height="40" MinWidth="140"
                                Command="{Binding StartOrganizeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AutoFix" Width="18" Height="18"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Organize Now" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══ Progress ════════════════════════════ -->
                <Border Visibility="{Binding IsOrganizing, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource DashboardCard}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Loading" Width="20" Height="20"
                                                     Foreground="{StaticResource AppPrimaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="SpinTransform" CenterX="10" CenterY="10" />
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinTransform"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock Text="Organizing files..."
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppOnSurfaceBrush}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Content="Cancel"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource AppErrorBrush}"
                                    Command="{Binding CancelOrganizeCommand}" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Foreground="{StaticResource AppPrimaryBrush}"
                                     Background="{StaticResource AppSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ═══ Summary Statistics (shown after organize) ════════ -->
                <UniformGrid Rows="1" Columns="1"
                             Margin="0,0,0,20"
                             Visibility="{Binding HasOrganized, Converter={StaticResource BoolToVis}}">

                    <!-- Stat: Organized Files -->
                    <Border CornerRadius="16" Padding="20" Margin="0,0,0,0"
                            Background="{StaticResource AppPrimaryGradient}"
                            MaxWidth="400" HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="#7C4DFF" />
                        </Border.Effect>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="FolderCheckOutline" Width="24" Height="24"
                                                     Foreground="White" Opacity="0.85"
                                                     Margin="0,0,0,10" />
                            <TextBlock Text="{Binding OrganizedCount}"
                                       FontSize="28" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Files Categorized"
                                       FontSize="12" Foreground="White" Opacity="0.8" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══ Status Message (when not organizing) ═══════════ -->
                <Border Visibility="{Binding IsOrganizing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10"
                        Padding="16,10"
                        Margin="0,0,0,16"
                        BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                 Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
