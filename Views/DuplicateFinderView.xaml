<UserControl x:Class="FilePilot.Views.DuplicateFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:FilePilot.Converters">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:FileSizeConverter x:Key="FileSizeConv" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <StackPanel Margin="32,8,32,32">

                <!-- ═══ Header ═══════════════════════════════════════ -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Duplicate Finder"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource AppOnSurfaceBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Find and remove duplicate files using SHA-256 hash comparison."
                               FontSize="13"
                               Foreground="{StaticResource AppOnSurfaceVariantBrush}" />
                </StackPanel>

                <!-- ═══ Folder Selection Card ════════════════════════ -->
                <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Folder Path Display -->
                        <Border Grid.Column="0"
                                Background="{StaticResource AppBackgroundBrush}"
                                CornerRadius="10"
                                BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                                BorderThickness="1"
                                Padding="14,10"
                                Margin="0,0,12,0">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="FolderSearch"
                                                         Width="20" Height="20"
                                                         Foreground="{StaticResource AppPrimaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceBrush}" />
                                            <Setter Property="Text" Value="{Binding SelectedFolderPath}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFolderPath}" Value="">
                                                    <Setter Property="Text" Value="No folder selected..." />
                                                    <Setter Property="Foreground" Value="{StaticResource AppOnSurfaceVariantBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Browse Button -->
                        <Button Grid.Column="1"
                                Content="Browse"
                                Margin="0,0,8,0"
                                Height="40" MinWidth="100"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource AppPrimaryBrush}"
                                Foreground="{StaticResource AppPrimaryBrush}"
                                Command="{Binding BrowseFolderCommand}" />

                        <!-- Scan / Cancel Button -->
                        <Button Grid.Column="2"
                                Height="40" MinWidth="120"
                                Command="{Binding StartScanCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Radar" Width="18" Height="18"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Start Scan" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══ Scanning Progress ════════════════════════════ -->
                <Border Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource DashboardCard}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Loading" Width="20" Height="20"
                                                     Foreground="{StaticResource AppPrimaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="SpinTransform" CenterX="10" CenterY="10" />
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinTransform"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock Text="Scanning in progress..."
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppOnSurfaceBrush}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Content="Cancel"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource AppErrorBrush}"
                                    Command="{Binding CancelScanCommand}" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Foreground="{StaticResource AppPrimaryBrush}"
                                     Background="{StaticResource AppSurfaceVariantBrush}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ═══ Summary Statistics (shown after scan) ════════ -->
                <UniformGrid Rows="1" Columns="3"
                             Margin="0,0,0,20"
                             Visibility="{Binding HasScanCompleted, Converter={StaticResource BoolToVis}}">

                    <!-- Stat: Duplicate Groups -->
                    <Border CornerRadius="16" Padding="20" Margin="0,0,10,0"
                            Background="{StaticResource AppWarningGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="#FF9800" />
                        </Border.Effect>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="ContentDuplicate" Width="24" Height="24"
                                                     Foreground="White" Opacity="0.85"
                                                     Margin="0,0,0,10" />
                            <TextBlock Text="{Binding TotalGroups}"
                                       FontSize="28" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Duplicate Groups"
                                       FontSize="12" Foreground="White" Opacity="0.8" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Stat: Extra Files -->
                    <Border CornerRadius="16" Padding="20" Margin="5,0,5,0"
                            Background="{StaticResource AppErrorGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="#FF5252" />
                        </Border.Effect>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="FileMultiple" Width="24" Height="24"
                                                     Foreground="White" Opacity="0.85"
                                                     Margin="0,0,0,10" />
                            <TextBlock Text="{Binding TotalDuplicateFiles}"
                                       FontSize="28" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Extra Copies"
                                       FontSize="12" Foreground="White" Opacity="0.8" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Stat: Wasted Space -->
                    <Border CornerRadius="16" Padding="20" Margin="10,0,0,0"
                            Background="{StaticResource AppPrimaryGradient}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.3" Color="#7C4DFF" />
                        </Border.Effect>
                        <StackPanel>
                            <materialDesign:PackIcon Kind="HarddiskRemove" Width="24" Height="24"
                                                     Foreground="White" Opacity="0.85"
                                                     Margin="0,0,0,10" />
                            <TextBlock Text="{Binding TotalWastedDisplay}"
                                       FontSize="28" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Wasted Space"
                                       FontSize="12" Foreground="White" Opacity="0.8" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══ Status Message (when not scanning) ═══════════ -->
                <Border Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        Background="{StaticResource AppSurfaceBrush}"
                        CornerRadius="10"
                        Padding="16,10"
                        Margin="0,0,0,16"
                        BorderBrush="{StaticResource AppSurfaceVariantBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                 Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- ═══ Results — Duplicate Groups ═══════════════════ -->
                <ItemsControl ItemsSource="{Binding DuplicateGroups}"
                              Visibility="{Binding HasScanCompleted, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Group Header -->
                                    <DockPanel Margin="0,0,0,14">
                                        <Border Width="36" Height="36"
                                                CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="#FF9800" Opacity="0.15" />
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="ContentDuplicate"
                                                                     Width="18" Height="18"
                                                                     Foreground="#FF9800"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppOnSurfaceBrush}">
                                                <Run Text="Group #" /><Run Text="{Binding GroupNumber, Mode=OneWay}" />
                                                <Run Text=" — " Foreground="{StaticResource AppOnSurfaceVariantBrush}" />
                                                <Run Text="{Binding DuplicateCount, Mode=OneWay, StringFormat='{}{0} files'}"
                                                     Foreground="{StaticResource AppOnSurfaceVariantBrush}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource AppOnSurfaceVariantBrush}">
                                                <Run Text="Hash: " /><Run Text="{Binding FileHash, Mode=OneWay}" />
                                                <Run Text="  •  Size: " />
                                                <Run Text="{Binding FileSizeBytes, Mode=OneWay, Converter={StaticResource FileSizeConv}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Files in this group -->
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8" Margin="0,0,0,4"
                                                        CornerRadius="8"
                                                        Background="Transparent"
                                                        Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{StaticResource AppSurfaceVariantBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- File Icon -->
                                                        <materialDesign:PackIcon Grid.Column="0"
                                                                                 Kind="FileDocument"
                                                                                 Width="18" Height="18"
                                                                                 Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                                                 VerticalAlignment="Center" />

                                                        <!-- File Info -->
                                                        <StackPanel Grid.Column="1" Margin="8,0,12,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource AppOnSurfaceBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Directory}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Open in Explorer -->
                                                        <Button Grid.Column="2"
                                                                ToolTip="Open in Explorer"
                                                                Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                Foreground="{StaticResource AppOnSurfaceVariantBrush}"
                                                                Command="{Binding DataContext.OpenInExplorerCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                CommandParameter="{Binding FullPath}">
                                                            <materialDesign:PackIcon Kind="FolderOpen"
                                                                                     Width="16" Height="16" />
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button Grid.Column="3"
                                                                ToolTip="Delete this copy"
                                                                Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                Foreground="#FF5252"
                                                                Command="{Binding DataContext.DeleteFileCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                     Width="16" Height="16" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
